# The TAIFEX-format fixture deliberately preserves padded source columns.
tests/fixtures/data_synthetic_taifex.csv whitespace=-blank-at-eol

# These artifacts are SHA-256-pinned as raw bytes, including their line endings.
tests/fixtures/desktop_runtime_0_2_1.py.txt -text

# Qt notice inputs are independently SHA-256-pinned as original upstream bytes.
packaging/qt_notices/** -text

# Preserve the pinned upstream Inno translation, including BOM and CRLF.
packaging/languages/ChineseTraditional.isl -text

# Literal documentation history preserves original bytes for provenance checks.
docs/agent/history/* -text

# The verbatim original README retains upstream trailing whitespace.
docs/agent/history/README_before_layering.md whitespace=-blank-at-eol

# Python source and the pinned Ruff tool lock use LF on every platform.
*.py text eol=lf
requirements-ruff.lock text eol=lf

# Frozen G3 producer files are excluded from Ruff and keep platform line-ending
# conversion so their pinned bytes and derived goldens match the pre-Ruff behaviour.
quantlab/research.py !eol
quantlab/provider.py !eol
quantlab/core.py !eol
quantlab/strategies.py !eol
quantlab/backtest.py !eol
quantlab/data.py !eol
desktop_chatgpt_auth.py !eol
desktop_chatgpt_provider.py !eol
quantlab/saved_candidate_pool.py !eol
