{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent App Tools v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "name",
    "capability",
    "effect",
    "inputSchema"
  ],
  "properties": {
    "contractVersion": {
      "type": "integer",
      "const": 1
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]{0,63}$"
    },
    "capability": {
      "enum": [
        "paper.read",
        "research.read",
        "research.run",
        "ui.navigate"
      ]
    },
    "effect": {
      "enum": [
        "mutation",
        "read"
      ]
    },
    "maxItems": {
      "type": "integer",
      "const": 50
    },
    "maxSerializedBytes": {
      "type": "integer",
      "const": 8192
    },
    "pageSizeCap": {
      "type": "integer",
      "const": 50
    },
    "inputSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "string",
                  "integer"
                ]
              },
              "minimum": {
                "type": "integer",
                "minimum": 0
              },
              "maximum": {
                "type": "integer",
                "minimum": 0
              },
              "minLength": {
                "type": "integer",
                "minimum": 0
              },
              "maxLength": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              }
            }
          }
        },
        "required": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "effect": {
            "const": "mutation"
          }
        }
      },
      "then": {
        "properties": {
          "inputSchema": {
            "properties": {
              "required": {
                "contains": {
                  "const": "idempotency_key"
                }
              },
              "properties": {
                "required": [
                  "idempotency_key"
                ],
                "properties": {
                  "idempotency_key": {
                    "required": [
                      "minLength"
                    ],
                    "properties": {
                      "type": {
                        "const": "string"
                      },
                      "minLength": {
                        "minimum": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "boundedReturn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "items",
        "count",
        "total",
        "truncated",
        "limit",
        "next_cursor",
        "reason",
        "field_truncations"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "items": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "completed",
              "observations"
            ],
            "properties": {
              "completed": {
                "type": "boolean"
              },
              "observations": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000000
              }
            }
          }
        },
        "truncated": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 66,
          "maxLength": 128
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "enum": [
            null,
            "item_limit",
            "byte_limit",
            "field_limit"
          ]
        },
        "field_truncations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "item",
              "field",
              "truncated"
            ],
            "properties": {
              "item": {
                "type": "integer",
                "minimum": 0,
                "maximum": 49
              },
              "field": {
                "type": "array",
                "items": {
                  "type": [
                    "string",
                    "integer"
                  ]
                }
              },
              "truncated": {
                "const": true
              }
            }
          }
        }
      }
    }
  }
}
